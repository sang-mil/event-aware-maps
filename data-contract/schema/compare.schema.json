{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tumgil.local/schema/compare.schema.json",
  "title": "귀가 방법 비교 (GET /routes/compare)",
  "description": "출발지는 프리셋(시설 또는 역 id)으로만 받는다. 사용자 위치는 받지 않는다. options 순서는 서버가 정한다.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "condition_label": {
          "type": "object",
          "properties": {
            "to_name": { "type": ["string", "null"] },
            "hour_label": { "type": "string", "description": "예: 20시대 출발" }
          },
          "required": ["to_name", "hour_label"],
          "additionalProperties": false
        },
        "headline": { "$ref": "common.schema.json#/$defs/headline" },
        "similar": { "type": "boolean", "description": "(2026-11 추가, 선택) 1·2순위가 같은 단계이고 배수 차이가 작아 어느 쪽도 괜찮음" },
        "last_train": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "at": { "$ref": "common.schema.json#/$defs/datetime_or_null" },
                "minutes_left": { "type": ["integer", "null"], "minimum": 0 },
                "imminent": { "type": "boolean", "description": "막차가 임박했는지" }
              },
              "required": ["at", "minutes_left", "imminent"],
              "additionalProperties": false
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "kind": { "enum": ["walk_to_other", "board_now", "wait_later"], "description": "다른 역까지 걷기 / 지금 바로 타기 / 기다렸다 타기" },
              "recommended": { "type": "boolean" },
              "title": { "type": "string" },
              "subtitle": { "type": "string" },
              "station_id": { "$ref": "common.schema.json#/$defs/id" },
              "board_hour": { "$ref": "common.schema.json#/$defs/hour" },
              "walk_min": { "$ref": "common.schema.json#/$defs/minutes_or_null" },
              "expected": { "$ref": "common.schema.json#/$defs/count_or_null" },
              "level": { "$ref": "common.schema.json#/$defs/level" },
              "compare_message": { "type": "string" },
              "share": { "type": "number", "minimum": 0, "maximum": 1, "description": "(2026-11 추가, 선택) 길 안내 분배 비율. 선택지 합 1" },
              "share_by_venue": {
                "type": "object",
                "description": "(2026-11 추가, 선택) 출발 공연장별 분배 비율. 너무 먼(도보 기준 초과) 선택지는 0",
                "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
                "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "walk_by_venue": {
                "type": "object",
                "description": "(2026-11 추가, 선택) 출발 공연장 id → 이 역까지 카카오 도보 경로. 경로가 없는 공연장은 빠짐",
                "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "walk_min": { "type": "integer", "minimum": 0 },
                    "distance_m": { "type": "integer", "minimum": 0 }
                  },
                  "required": ["walk_min", "distance_m"],
                  "additionalProperties": false
                }
              },
              "uncertain": { "type": "boolean", "description": "(2026-11 추가, 선택) 관객 수를 모르는 공연이 있어 실제로는 더 붐빌 수 있음" }
            },
            "required": ["id", "kind", "recommended", "title", "subtitle", "station_id", "board_hour", "walk_min", "expected", "level", "compare_message"],
            "additionalProperties": false
          }
        }
      },
      "required": ["condition_label", "headline", "last_train", "options"],
      "additionalProperties": false
    }
  }
}
